---
import { Menu, X } from '@lucide/astro';

const discordIcon = 'https://cdn.simpleicons.org/discord/white';
const instagramIcon = 'https://cdn.simpleicons.org/instagram/white';
const linkedinIcon = '/assets/linkedin.svg';
const discordUrl = 'https://discord.gg/Rf4cW4AvzJ';

const primaryLinks = [
	{ href: 'https://brownrisdgames.itch.io/', label: 'GAMES', external: true },
	{
		href: 'https://brgd.bandcamp.com/',
		label: 'SOUNDTRACKS',
		external: true,
	},
];
const secondaryLinks = [
	{
		href: 'https://docs.brownrisd.games/',
		label: 'CLUB DOCUMENTATION',
		mobileLabel: 'DOCS',
		tabletLabel: 'DOCS',
	},
	{ href: '/team', label: 'E-BOARD' },
	{
		href: 'https://docs.brownrisd.games/getting-started/join-us/',
		label: 'JOIN US!',
	},
];
const navLinksClass =
	'flex items-center gap-12 whitespace-nowrap text-base leading-[21px] font-medium max-[1180px]:gap-11 max-[900px]:gap-7 max-[900px]:text-sm max-[900px]:leading-5';
const socialLinkClass =
	'flex size-6 items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background';
---

<header
	class="relative flex h-20 w-full items-center justify-between gap-8 max-[1180px]:gap-6 max-[900px]:gap-4 max-[720px]:hidden"
	data-node-id="5:2351"
>
	<div
		class="flex h-full min-w-0 flex-1 items-center gap-12 max-[1180px]:gap-11 max-[900px]:gap-7"
		data-node-id="5:3095"
	>
		<a
			class="flex h-16 w-14 flex-none items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background max-[720px]:h-14 max-[720px]:w-12"
			href="/"
			aria-label="Brown RISD Game Developers home"
		>
			<img
				class="block h-16 w-14 object-cover max-[720px]:h-14 max-[720px]:w-12"
				src="/assets/brgd-logo-white.png"
				alt="Brown RISD Game Developers logo"
				width="56"
				height="64"
				draggable="false"
				loading="eager"
			/>
		</a>

		<nav class={navLinksClass} aria-label="Primary">
			{
				primaryLinks.map(link => (
					<a
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>

	<div
		class="flex h-full items-center justify-end gap-12 max-[1180px]:gap-11 max-[900px]:gap-7"
	>
		<nav class={navLinksClass} aria-label="Secondary">
			{
				secondaryLinks.map(link => (
					<a href={link.href}>
						{link.tabletLabel ? (
							<>
								<span class="max-[1180px]:hidden">
									{link.label}
								</span>
								<span class="hidden max-[1180px]:inline">
									{link.tabletLabel}
								</span>
							</>
						) : (
							link.label
						)}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-6 max-[900px]:gap-4">
			<a class={socialLinkClass} href={discordUrl} aria-label="Discord">
				<img
					class="block size-full max-w-none object-contain"
					src={discordIcon}
					alt=""
					width="24"
					height="24"
					draggable="false"
					loading="eager"
				/>
			</a>

			<a
				class={socialLinkClass}
				href="https://www.instagram.com/brownrisdgamedev/"
				aria-label="Instagram"
			>
				<img
					class="block size-full max-w-none object-contain"
					src={instagramIcon}
					alt=""
					width="24"
					height="24"
					draggable="false"
					loading="eager"
				/>
			</a>

			<a
				class={socialLinkClass}
				href="https://www.linkedin.com/company/brown-risd-game-developers/"
				aria-label="LinkedIn"
			>
				<img
					class="block size-full max-w-none object-contain"
					src={linkedinIcon}
					alt=""
					width="24"
					height="24"
					draggable="false"
					loading="eager"
				/>
			</a>
		</div>
	</div>
</header>

<header
	class="relative z-50 hidden w-full items-center justify-between gap-4 max-[720px]:flex"
	aria-label="Mobile navigation"
>
	<a
		class="flex h-14 w-12 flex-none items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background"
		href="/"
		aria-label="Brown RISD Game Developers home"
	>
		<img
			class="block h-14 w-12 object-cover"
			src="/assets/brgd-logo-white.png"
			alt="Brown RISD Game Developers logo"
			width="48"
			height="56"
			draggable="false"
			loading="eager"
		/>
	</a>

	<div class="ml-auto flex items-center gap-5">
		<a
			class="flex size-6 items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background"
			href={discordUrl}
			aria-label="Discord"
		>
			<img
				class="block size-full max-w-none object-contain"
				src={discordIcon}
				alt=""
				width="24"
				height="24"
				draggable="false"
				loading="eager"
			/>
		</a>

		<button
			type="button"
			class="flex size-11 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background"
			aria-label="Open navigation menu"
			aria-controls="mobile-nav-panel"
			aria-expanded="false"
			data-mobile-nav-open
		>
			<Menu class="size-6" aria-hidden="true" stroke-width={1.75} />
		</button>
	</div>
</header>

<dialog
	id="mobile-nav-panel"
	class="m-0 h-[100dvh] max-h-none w-screen max-w-none translate-x-full border-0 bg-page-background p-0 text-white opacity-0 transition-[transform,opacity] duration-200 ease-out backdrop:bg-black/60 data-[open=true]:translate-x-0 data-[open=true]:opacity-100 motion-reduce:transition-none"
	aria-label="Mobile navigation menu"
	data-mobile-nav-panel
>
	<div class="flex min-h-full flex-col px-5 py-4">
		<div class="flex h-14 items-center justify-between gap-5">
			<a
				class="flex h-14 w-12 flex-none items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
				href="/"
				aria-label="Brown RISD Game Developers home"
			>
				<img
					class="block h-14 w-12 object-cover"
					src="/assets/brgd-logo-white.png"
					alt="Brown RISD Game Developers logo"
					width="48"
					height="56"
					draggable="false"
					loading="eager"
				/>
			</a>

			<div class="ml-auto flex items-center">
				<button
					type="button"
					class="flex size-11 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
					aria-label="Close navigation menu"
					data-mobile-nav-close
				>
					<X class="size-6" aria-hidden="true" stroke-width={1.75} />
				</button>
			</div>
		</div>

		<nav
			class="-mx-5 mt-6 flex flex-col border-t border-white text-xl font-medium uppercase"
			aria-label="Mobile menu"
		>
			{
				primaryLinks.map(link => (
					<a
						class="border-b border-white/50 px-5 py-4"
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener' : undefined}
					>
						{link.label}
					</a>
				))
			}

			{
				secondaryLinks.map((link, index) => (
					<a
						class:list={[
							'border-b px-5 py-4',
							index === secondaryLinks.length - 1
								? 'border-white'
								: 'border-white/50',
						]}
						href={link.href}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="-mx-5 grid grid-cols-3 border-b border-white text-xs font-medium uppercase">
			<a
				class="flex min-w-0 items-center justify-center gap-2 border-r border-white px-2 py-4"
				href={discordUrl}
			>
				<img
					class="block size-5 max-w-none object-contain"
					src={discordIcon}
					alt=""
					width="20"
					height="20"
					draggable="false"
					loading="eager"
				/>
				<span>Discord</span>
			</a>

			<a
				class="flex min-w-0 items-center justify-center gap-2 border-r border-white px-2 py-4"
				href="https://www.instagram.com/brownrisdgamedev/"
			>
				<img
					class="block size-5 max-w-none object-contain"
					src={instagramIcon}
					alt=""
					width="20"
					height="20"
					draggable="false"
					loading="eager"
				/>
				<span>Instagram</span>
			</a>

			<a
				class="flex min-w-0 items-center justify-center gap-2 px-2 py-4"
				href="https://www.linkedin.com/company/brown-risd-game-developers/"
			>
				<img
					class="block size-5 max-w-none object-contain"
					src={linkedinIcon}
					alt=""
					width="20"
					height="20"
					draggable="false"
					loading="eager"
				/>
				<span>LinkedIn</span>
			</a>
		</div>
	</div>
</dialog>

<script>
	const openButton = document.querySelector('[data-mobile-nav-open]');
	const panel = document.querySelector('[data-mobile-nav-panel]');
	const closeButton = panel?.querySelector('[data-mobile-nav-close]');

	if (
		openButton instanceof HTMLButtonElement &&
		panel instanceof HTMLDialogElement &&
		closeButton instanceof HTMLButtonElement
	) {
		let closeTimer: number | undefined;

		const closePanel = () => {
			panel.dataset.open = 'false';
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(() => {
				if (panel.open) {
					panel.close();
				}
			}, 200);
		};

		openButton.addEventListener('click', () => {
			if (panel.open) {
				return;
			}

			window.clearTimeout(closeTimer);
			panel.showModal();
			document.documentElement.style.overflow = 'hidden';
			openButton.setAttribute('aria-expanded', 'true');

			window.requestAnimationFrame(() => {
				panel.dataset.open = 'true';
				closeButton.focus();
			});
		});

		closeButton.addEventListener('click', closePanel);

		panel.addEventListener('cancel', event => {
			event.preventDefault();
			closePanel();
		});

		document.addEventListener('keydown', event => {
			if (event.key === 'Escape' && panel.open) {
				event.preventDefault();
				closePanel();
			}
		});

		panel.addEventListener('close', () => {
			document.documentElement.style.removeProperty('overflow');
			openButton.setAttribute('aria-expanded', 'false');
			openButton.focus();
		});

		for (const link of panel.querySelectorAll('a')) {
			link.addEventListener('click', closePanel);
		}
	}
</script>
