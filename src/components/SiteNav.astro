---
const discordIcon = "https://cdn.simpleicons.org/discord/white";
const instagramIcon = "https://cdn.simpleicons.org/instagram/white";
const primaryLinks = [
  { href: "https://brownrisdgames.itch.io/", label: "GAMES" },
  { href: "https://brgd.bandcamp.com/", label: "SOUNDTRACKS" }
];
const secondaryLinks = [
  { href: "https://docs.brownrisd.games/", label: "CLUB DOCUMENTATION", mobileLabel: "DOCS", tabletLabel: "DOCS" },
  { href: "/team", label: "TEAM" },
  { href: "#join", label: "JOIN US!" }
];
const navLinksClass =
  "flex items-center gap-12 whitespace-nowrap text-base leading-[21px] font-medium max-[1180px]:gap-11 max-[900px]:gap-7 max-[900px]:text-sm max-[900px]:leading-5";
const socialLinkClass =
  "flex size-6 items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background";
---

<header
  class="relative flex h-20 w-full items-center justify-between gap-8 max-[1180px]:gap-6 max-[900px]:gap-4 max-[720px]:hidden"
  data-node-id="5:2351"
>
  <div
    class="flex h-full min-w-0 flex-1 items-center gap-12 max-[1180px]:gap-11 max-[900px]:gap-7"
    data-node-id="5:3095"
  >
    <a
      class="flex h-16 w-14 flex-none items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background max-[720px]:h-14 max-[720px]:w-12"
      href="/"
      aria-label="Brown RISD Game Developers home"
    >
      <img
        class="block h-16 w-14 object-cover max-[720px]:h-14 max-[720px]:w-12"
        src="/assets/brgd-logo-white.png"
        alt="Brown RISD Game Developers logo"
        width="56"
        height="64"
        draggable="false"
        loading="eager"
      />
    </a>

    <nav class={navLinksClass} aria-label="Primary">
      {primaryLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>

  <div class="flex h-full items-center justify-end gap-12 max-[1180px]:gap-11 max-[900px]:gap-7">
    <nav class={navLinksClass} aria-label="Secondary">
      {secondaryLinks.map((link) => (
        <a href={link.href}>
          {link.tabletLabel ? (
            <>
              <span class="max-[1180px]:hidden">{link.label}</span>
              <span class="hidden max-[1180px]:inline">{link.tabletLabel}</span>
            </>
          ) : (
            link.label
          )}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-6 max-[900px]:gap-4">
      <a
        class={socialLinkClass}
        href="https://discord.gg/dhrKyse6RH"
        aria-label="Discord"
      >
        <img class="block size-full max-w-none object-contain" src={discordIcon} alt="" width="24" height="24" draggable="false" loading="eager" />
      </a>

      <a
        class={socialLinkClass}
        href="https://www.instagram.com/brownrisdgamedev/"
        aria-label="Instagram"
      >
        <img class="block size-full max-w-none object-contain" src={instagramIcon} alt="" width="24" height="24" draggable="false" loading="eager" />
      </a>
    </div>
  </div>
</header>

<header
  class="relative hidden w-full items-end justify-between gap-4 max-[720px]:flex"
  aria-label="Mobile navigation"
>
  <a
    class="flex h-14 w-12 flex-none items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background"
    href="/"
    aria-label="Brown RISD Game Developers home"
  >
    <img
      class="block h-14 w-12 object-cover"
      src="/assets/brgd-logo-white.png"
      alt="Brown RISD Game Developers logo"
      width="48"
      height="56"
      draggable="false"
      loading="eager"
    />
  </a>

  <div class="ml-auto flex min-w-0 items-end gap-5">
    <div class="flex min-w-0 flex-col items-end gap-2 text-right text-sm leading-5 font-medium whitespace-nowrap">
      <nav class="flex items-center justify-end gap-5 max-[360px]:gap-3" aria-label="Primary mobile">
        {primaryLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>

      <nav class="flex items-center justify-end gap-4 max-[360px]:gap-3" aria-label="Secondary mobile">
        {secondaryLinks.map((link) => (
          <a href={link.href}>{link.mobileLabel ?? link.label}</a>
        ))}
      </nav>
    </div>

    <div class="flex flex-col items-center gap-4">
      <a
        class="flex size-4 items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background"
        href="https://discord.gg/dhrKyse6RH"
        aria-label="Discord"
      >
        <img class="block size-full max-w-none object-contain" src={discordIcon} alt="" width="16" height="16" draggable="false" loading="eager" />
      </a>

      <a
        class="flex size-4 items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-page-background"
        href="https://www.instagram.com/brownrisdgamedev/"
        aria-label="Instagram"
      >
        <img class="block size-full max-w-none object-contain" src={instagramIcon} alt="" width="16" height="16" draggable="false" loading="eager" />
      </a>
    </div>
  </div>
</header>
