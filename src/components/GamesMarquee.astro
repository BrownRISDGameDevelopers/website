---
import GameCard from "./GameCard.astro";

interface Card {
  title: string;
  image: string;
  imageAlt: string;
  season: string;
  href?: string;
}

interface Props {
  cards: Card[];
  apiEndpoint?: string;
}

const { cards, apiEndpoint = "/api/itch-games" } = Astro.props;
const marqueeCards = cards.length > 1 ? [...cards, ...cards] : cards;
---

<section
  id="games"
  class="relative left-1/2 w-screen -translate-x-1/2 self-start max-[720px]:mt-1"
  aria-label="Featured games"
  data-node-id="5:3132"
  data-games-marquee
  data-games-api={apiEndpoint}
>
  <div class="overflow-hidden">
    <div
      class="w-full cursor-grab overflow-x-auto overflow-y-hidden pl-16 select-none touch-pan-y [scrollbar-gutter:stable] [scrollbar-width:none] [-ms-overflow-style:none] [-webkit-overflow-scrolling:touch] [&::-webkit-scrollbar]:hidden data-[dragging=true]:cursor-grabbing max-[1180px]:pl-5 max-[720px]:cursor-default max-[720px]:overflow-x-hidden max-[720px]:pl-5"
      data-games-viewport
    >
      <div class="flex w-max gap-6 max-[720px]:gap-4" data-games-track data-games-count={cards.length}>
        {marqueeCards.map((card) => (
          <div data-games-card>
            <GameCard {...card} />
          </div>
        ))}
      </div>
    </div>
  </div>

  <template data-games-card-template>
    <div data-games-card>
      <GameCard
        title="Template title"
        image="/assets/pickleball-violence.png"
        imageAlt=""
        season="FALL 2025"
        href="#"
      />
    </div>
  </template>
</section>

<style>
  @keyframes games-marquee-mobile {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(calc(var(--marquee-cycle, 0px) * -1), 0, 0);
    }
  }

  @media (max-width: 720px) {
    [data-games-track][data-mobile-animated="true"] {
      animation: games-marquee-mobile var(--marquee-duration, 24s) linear infinite;
      will-change: transform;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-games-track][data-mobile-animated="true"] {
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  type ClientCard = {
    title: string;
    image: string;
    imageAlt: string;
    season: string;
    href?: string;
  };

  const marquees = document.querySelectorAll("[data-games-marquee]");

  for (const marquee of marquees) {
    if (!(marquee instanceof HTMLElement)) {
      continue;
    }

    const viewport = marquee.querySelector("[data-games-viewport]");
    const track = marquee.querySelector("[data-games-track]");
    const cardTemplate = marquee.querySelector("[data-games-card-template]");
    const apiEndpoint = marquee.dataset.gamesApi;

    if (
      !(viewport instanceof HTMLElement) ||
      !(track instanceof HTMLElement) ||
      !(cardTemplate instanceof HTMLTemplateElement)
    ) {
      continue;
    }

    let velocity = 0;
    let lastFrame = 0;
    let cycleDistance = 0;
    let isDragging = false;
    let isHovering = false;
    let activePointerId: number | null = null;
    let lastPointerX = 0;
    let lastPointerTime = 0;
    let draggedDistance = 0;
    let suppressClick = false;
    const autoSpeed = 44;

    viewport.dataset.dragging = "false";

    const usesMobileAnimation = () => window.matchMedia("(max-width: 720px)").matches;

    const normalizeCards = (cards: ClientCard[]) => (cards.length > 1 ? [...cards, ...cards] : cards);

    const buildCard = (card: ClientCard) => {
      const fragment = cardTemplate.content.cloneNode(true);

      if (!(fragment instanceof DocumentFragment)) {
        return null;
      }

      const cardRoot = fragment.querySelector("[data-games-card]");
      const image = fragment.querySelector("img");
      const title = fragment.querySelector("h2");
      const season = fragment.querySelector("p");
      const link = fragment.querySelector("a");

      if (
        !(cardRoot instanceof HTMLElement) ||
        !(image instanceof HTMLImageElement) ||
        !(title instanceof HTMLElement) ||
        !(season instanceof HTMLElement) ||
        !(link instanceof HTMLAnchorElement)
      ) {
        return null;
      }

      image.src = card.image;
      image.alt = card.imageAlt;
      title.textContent = card.title;
      season.textContent = card.season;
      link.href = card.href ?? "#";

      return cardRoot;
    };

    const renderCards = (cards: ClientCard[]) => {
      const renderedCards = normalizeCards(cards)
        .map((card) => buildCard(card))
        .filter((card) => card instanceof HTMLElement);

      if (renderedCards.length === 0) {
        return;
      }

      track.replaceChildren(...renderedCards);
      track.dataset.gamesCount = String(cards.length);
      viewport.scrollLeft = 0;
      measureCycle();
      wrapScroll();
    };

    const loadCards = async () => {
      if (!apiEndpoint) {
        return;
      }

      try {
        const response = await fetch(apiEndpoint, {
          headers: {
            Accept: "application/json"
          }
        });

        if (!response.ok) {
          throw new Error(`Request failed with status ${response.status}`);
        }

        const data = (await response.json()) as { games?: ClientCard[] };

        if (!Array.isArray(data.games) || data.games.length === 0) {
          return;
        }

        renderCards(data.games);
      } catch (error) {
        console.error("Failed to load itch games", error);
      }
    };

    const measureCycle = () => {
      const count = Number.parseInt(track.dataset.gamesCount ?? "0", 10);
      const cards = track.querySelectorAll("[data-games-card]");

      if (count < 2 || cards.length <= count) {
        cycleDistance = 0;
        return;
      }

      const firstCard = cards[0];
      const repeatedCard = cards[count];

      if (!(firstCard instanceof HTMLElement) || !(repeatedCard instanceof HTMLElement)) {
        cycleDistance = 0;
        return;
      }

      cycleDistance = repeatedCard.offsetLeft - firstCard.offsetLeft;
      applyMobileAnimation();
    };

    const applyMobileAnimation = () => {
      if (!usesMobileAnimation() || cycleDistance <= 0) {
        track.dataset.mobileAnimated = "false";
        track.style.removeProperty("--marquee-cycle");
        track.style.removeProperty("--marquee-duration");
        track.style.transform = "";
        return;
      }

      track.dataset.mobileAnimated = "true";
      track.style.setProperty("--marquee-cycle", `${cycleDistance}px`);
      track.style.setProperty(
        "--marquee-duration",
        `${Math.max(cycleDistance / autoSpeed, 12).toFixed(2)}s`
      );
      viewport.scrollLeft = 0;
    };

    const wrapScroll = () => {
      if (cycleDistance <= 0) {
        return;
      }

      while (viewport.scrollLeft >= cycleDistance) {
        viewport.scrollLeft -= cycleDistance;
      }

      while (viewport.scrollLeft < 0) {
        viewport.scrollLeft += cycleDistance;
      }
    };

    const animate = (timestamp: number) => {
      if (!lastFrame) {
        lastFrame = timestamp;
      }

      const deltaSeconds = (timestamp - lastFrame) / 1000;
      lastFrame = timestamp;

      if (usesMobileAnimation()) {
        window.requestAnimationFrame(animate);
        return;
      }

      if (!isDragging) {
        if (!isHovering && cycleDistance > 0) {
          viewport.scrollLeft += autoSpeed * deltaSeconds;
        }

        if (Math.abs(velocity) > 1) {
          viewport.scrollLeft -= velocity * deltaSeconds;
          velocity *= Math.pow(0.92, deltaSeconds * 60);
        }

        wrapScroll();
      }

      window.requestAnimationFrame(animate);
    };

    const endDrag = (event: PointerEvent) => {
      if (!isDragging || event.pointerId !== activePointerId) {
        return;
      }

      if (viewport.hasPointerCapture(event.pointerId)) {
        viewport.releasePointerCapture(event.pointerId);
      }

      isDragging = false;
      activePointerId = null;
      lastPointerTime = 0;
      viewport.dataset.dragging = "false";

      if (draggedDistance > 6) {
        suppressClick = true;

        window.setTimeout(() => {
          suppressClick = false;
        }, 0);
      }
    };

    viewport.addEventListener("pointerdown", (event) => {
      if (usesMobileAnimation()) {
        return;
      }

      if (event.button !== 0) {
        return;
      }

      if (
        event.target instanceof Element &&
        event.target.closest("a, button, input, textarea, select, label, summary")
      ) {
        return;
      }

      isDragging = true;
      velocity = 0;
      activePointerId = event.pointerId;
      lastPointerX = event.clientX;
      lastPointerTime = performance.now();
      draggedDistance = 0;
      lastFrame = 0;
      viewport.dataset.dragging = "true";
      viewport.setPointerCapture(event.pointerId);
    });

    viewport.addEventListener("pointermove", (event) => {
      if (usesMobileAnimation()) {
        return;
      }

      if (!isDragging || event.pointerId !== activePointerId) {
        return;
      }

      const now = performance.now();
      const deltaX = event.clientX - lastPointerX;
      const deltaMs = Math.max(16, now - lastPointerTime);
      lastPointerX = event.clientX;
      lastPointerTime = now;
      draggedDistance += Math.abs(deltaX);
      velocity = (deltaX / deltaMs) * 1000;
      viewport.scrollLeft -= deltaX;
      wrapScroll();
      event.preventDefault();
    });

    viewport.addEventListener("pointerenter", () => {
      isHovering = true;
    });

    viewport.addEventListener("pointerleave", () => {
      isHovering = false;
    });

    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);
    viewport.addEventListener("scroll", wrapScroll, { passive: true });

    marquee.addEventListener(
      "click",
      (event) => {
        if (!suppressClick) {
          return;
        }

        event.preventDefault();
        event.stopPropagation();
      },
      true
    );

    const resizeObserver = new ResizeObserver(() => {
      measureCycle();
      wrapScroll();
    });

    resizeObserver.observe(viewport);
    resizeObserver.observe(track);
    measureCycle();
    wrapScroll();
    window.addEventListener("resize", applyMobileAnimation);
    void loadCards();
    window.requestAnimationFrame(animate);
  }
</script>
