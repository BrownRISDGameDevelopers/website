---
interface Props {
  title: string;
  image: string;
  imageAlt: string;
  season: string;
  href?: string;
}

const {
  title,
  image,
  imageAlt,
  season,
  href = "#"
} = Astro.props;

const ctaClass =
  "pointer-events-auto relative z-0 inline-flex h-13 w-36 items-center justify-center border border-white bg-transparent text-lg/[24px] font-normal uppercase after:pointer-events-none after:absolute after:inset-0 after:-z-10 after:translate-x-[6px] after:translate-y-[6px] after:border after:border-white/33 after:bg-transparent after:[clip-path:polygon(100%_0,_100%_100%,_0_100%,_0_calc(100%_-_6px),_calc(100%_-_6px)_calc(100%_-_6px),_calc(100%_-_6px)_0)] max-[720px]:h-12 max-[720px]:w-full max-[720px]:text-base/[22px]";
---

<article class="flex min-h-[440px] w-[315px] flex-none flex-col border border-white bg-transparent max-[720px]:min-h-[408px] max-[720px]:w-[min(296px,80vw)] max-[420px]:min-h-[388px] max-[420px]:w-[min(264px,84vw)]">
  <div class="aspect-[63/50] overflow-hidden">
    <img class="block h-full w-full object-cover" src={image} alt={imageAlt} width="315" height="250" draggable="false" loading="eager" />
  </div>

  <div class="flex flex-1 flex-col gap-6 border-t border-white p-6 max-[720px]:gap-4 max-[720px]:p-4">
    <div class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-3 max-[720px]:grid-cols-1 max-[720px]:gap-2">
      <h2 class="m-0 min-h-[57.6px] text-[24px]/[1.2] font-medium uppercase line-clamp-2 max-[720px]:min-h-[48px] max-[720px]:text-[20px]/[1.2]">
        {title}
      </h2>

      <p class="m-0 whitespace-nowrap text-sm font-medium uppercase max-[720px]:text-xs">
        {season}
      </p>
    </div>

    <a
      class={`${ctaClass} mt-auto self-start`}
      href={href}
      target="_blank"
      rel="noopener noreferrer"
    >
      PLAY NOW
    </a>
  </div>
</article>
