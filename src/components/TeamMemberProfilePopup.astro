---
import { X } from '@lucide/astro';
---

<div class="pointer-events-none fixed inset-0 z-50" data-team-popup-root hidden>
	<section
		class="pointer-events-auto fixed left-4 top-4 flex w-[352px] max-w-[calc(100vw-2rem)] flex-col overflow-hidden border border-white/90 bg-[#181a2e]/25 text-white backdrop-blur-md"
		role="dialog"
		aria-modal="false"
		aria-labelledby="team-profile-name"
		data-team-popup
	>
		<header
			class="flex cursor-grab items-center justify-between border-b border-white/90 px-3 py-3 select-none active:cursor-grabbing"
			data-team-popup-drag-handle
		>
			<p class="m-0 text-xl leading-normal">PROFILE</p>

			<button
				type="button"
				class="flex size-5 items-center justify-center border-0 bg-transparent p-0 text-white hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
				aria-label="Close profile"
				data-team-popup-close
			>
				<X class="size-5" aria-hidden="true" stroke-width={1.75} />
			</button>
		</header>

		<div
			class="grid grid-cols-[112px_minmax(0,1fr)] border-b border-white/90"
		>
			<div
				class="flex min-h-28 items-center justify-center border-r border-white/90 bg-[#111325]/80 p-5"
			>
				<img
					class="block h-full w-full object-contain"
					src="/assets/brgd-logo-white.png"
					alt="BRGD logo"
					width="56"
					height="64"
					draggable="false"
					loading="eager"
				/>
			</div>

			<div class="flex flex-col justify-center gap-1 p-3">
				<p
					id="team-profile-name"
					class="m-0 text-[22px] leading-normal uppercase"
					data-team-popup-name
				>
				</p>
				<p
					class="m-0 text-sm font-semibold leading-normal"
					data-team-popup-school
				>
				</p>
			</div>
		</div>

		<div
			class="flex max-h-[calc(100vh-9rem)] flex-col gap-3 overflow-y-auto p-3 max-[720px]:max-h-[calc(100vh-10rem)]"
		>
			<p
				class="m-0 text-[18px] leading-normal whitespace-pre-line"
				data-team-popup-bio
			>
			</p>

			<div
				class="flex flex-col gap-0 text-sm leading-normal text-white/80"
				data-team-popup-games
			>
			</div>

			<div
				class="grid grid-cols-2 gap-3 max-[520px]:grid-cols-1"
				data-team-popup-links
				hidden
			>
			</div>
		</div>
	</section>
</div>

<script>
	type PopupGame = {
		role: string;
		title: string;
	};

	type PopupLink = {
		label: string;
		url: string;
	};

	type PopupMember = {
		bio: string;
		games: PopupGame[];
		grad: number;
		isEBoard: boolean;
		links: PopupLink[];
		name: string;
		school: 'RISD' | 'BROWN' | 'BROWN|RISD';
	};

	const popupRoot = document.querySelector('[data-team-popup-root]');
	const popup = document.querySelector('[data-team-popup]');
	const dragHandle = document.querySelector('[data-team-popup-drag-handle]');
	const closeButton = document.querySelector('[data-team-popup-close]');
	const nameElement = document.querySelector('[data-team-popup-name]');
	const schoolElement = document.querySelector('[data-team-popup-school]');
	const bioElement = document.querySelector('[data-team-popup-bio]');
	const gamesElement = document.querySelector('[data-team-popup-games]');
	const linksElement = document.querySelector('[data-team-popup-links]');
	const triggerElements = document.querySelectorAll(
		'[data-team-member-trigger]',
	);

	if (
		popupRoot instanceof HTMLElement &&
		popup instanceof HTMLElement &&
		dragHandle instanceof HTMLElement &&
		closeButton instanceof HTMLButtonElement &&
		nameElement instanceof HTMLElement &&
		schoolElement instanceof HTMLElement &&
		bioElement instanceof HTMLElement &&
		gamesElement instanceof HTMLElement &&
		linksElement instanceof HTMLElement
	) {
		let activePointerId: number | null = null;
		let dragOffsetX = 0;
		let dragOffsetY = 0;

		const getSchoolMarkup = (
			school: PopupMember['school'],
			grad: number,
			isEBoard: boolean,
		) => {
			const gradLabel = `‘${String(grad).slice(-2)}`;
			const eBoardMarkup = isEBoard
				? '<span class="mx-2 inline-block size-[4px] translate-y-[-1px] bg-white/66 align-middle"></span><span class="text-[#d8f5ff]/85">E-BOARD</span>'
				: '';

			if (school === 'BROWN|RISD') {
				return `<span class="text-[#d3c1bb]">BROWN</span><span class="text-white">|</span><span class="text-[#dfddff]">RISD</span><span class="text-white"> ${gradLabel}</span>${eBoardMarkup}`;
			}

			const schoolClass =
				school === 'RISD' ? 'text-[#dfddff]' : 'text-[#d3c1bb]';
			return `<span class="${schoolClass}">${school}</span><span class="text-white"> ${gradLabel}</span>${eBoardMarkup}`;
		};

		const clampPosition = (left: number, top: number) => {
			const popupRect = popup.getBoundingClientRect();
			const maxLeft = Math.max(
				16,
				window.innerWidth - popupRect.width - 16,
			);
			const maxTop = Math.max(
				16,
				window.innerHeight - popupRect.height - 16,
			);

			popup.style.left = `${Math.min(Math.max(16, left), maxLeft)}px`;
			popup.style.top = `${Math.min(Math.max(16, top), maxTop)}px`;
		};

		const centerPopup = () => {
			popupRoot.hidden = false;
			popup.style.left = '16px';
			popup.style.top = '16px';

			window.requestAnimationFrame(() => {
				const popupRect = popup.getBoundingClientRect();
				clampPosition(
					(window.innerWidth - popupRect.width) / 2,
					(window.innerHeight - popupRect.height) / 2,
				);
			});
		};

		const closePopup = () => {
			popupRoot.hidden = true;
			activePointerId = null;
		};

		const renderLinks = (links: PopupLink[]) => {
			linksElement.replaceChildren();

			if (links.length === 0) {
				linksElement.hidden = true;
				return;
			}

			const fragment = document.createDocumentFragment();

			for (const link of links.slice(0, 2)) {
				const anchor = document.createElement('a');
				anchor.href = link.url;
				anchor.target = '_blank';
				anchor.rel = 'noopener noreferrer';
				anchor.className =
					'relative inline-flex items-center justify-center border border-white px-6 py-3 text-sm leading-normal uppercase shadow-[4px_4px_0px_0px_rgba(255,255,255,0.24)]';
				anchor.textContent = link.label;
				fragment.append(anchor);
			}

			linksElement.hidden = false;
			linksElement.append(fragment);
		};

		const renderGames = (member: PopupMember) => {
			gamesElement.replaceChildren();

			if (member.games.length === 0) {
				gamesElement.hidden = true;
				return;
			}

			for (const game of member.games) {
				const paragraph = document.createElement('p');
				paragraph.className = 'm-0';
				paragraph.textContent = game.role
					? `${game.role}, ${game.title}`
					: game.title;
				gamesElement.append(paragraph);
			}

			gamesElement.hidden = false;
		};

		const openPopup = (member: PopupMember, trigger?: HTMLElement) => {
			const wasHidden = popupRoot.hidden;
			nameElement.textContent = member.name.toLocaleUpperCase('en-US');
			schoolElement.innerHTML = getSchoolMarkup(
				member.school,
				member.grad,
				member.isEBoard,
			);
			bioElement.textContent = member.bio;
			renderGames(member);
			renderLinks(member.links);

			if (wasHidden) {
				centerPopup();
			}

			if (wasHidden && trigger instanceof HTMLElement) {
				window.requestAnimationFrame(() => {
					const triggerRect = trigger.getBoundingClientRect();
					clampPosition(triggerRect.left, triggerRect.top + 12);
				});
			}
		};

		for (const trigger of triggerElements) {
			if (!(trigger instanceof HTMLButtonElement)) {
				continue;
			}

			trigger.addEventListener('click', () => {
				const payload = trigger.dataset.teamMember;

				if (!payload) {
					return;
				}

				openPopup(JSON.parse(payload) as PopupMember, trigger);
			});
		}

		closeButton.addEventListener('click', closePopup);

		window.addEventListener('keydown', event => {
			if (event.key === 'Escape') {
				closePopup();
			}
		});

		dragHandle.addEventListener('pointerdown', event => {
			if (
				event.button !== 0 ||
				(event.target instanceof Element &&
					event.target.closest(
						'[data-team-popup-close], a, button, input, textarea, select',
					))
			) {
				return;
			}

			const popupRect = popup.getBoundingClientRect();
			activePointerId = event.pointerId;
			dragOffsetX = event.clientX - popupRect.left;
			dragOffsetY = event.clientY - popupRect.top;
			dragHandle.setPointerCapture(event.pointerId);
		});

		dragHandle.addEventListener('pointermove', event => {
			if (event.pointerId !== activePointerId) {
				return;
			}

			clampPosition(
				event.clientX - dragOffsetX,
				event.clientY - dragOffsetY,
			);
		});

		const endDrag = (event: PointerEvent) => {
			if (event.pointerId !== activePointerId) {
				return;
			}

			if (dragHandle.hasPointerCapture(event.pointerId)) {
				dragHandle.releasePointerCapture(event.pointerId);
			}

			activePointerId = null;
		};

		dragHandle.addEventListener('pointerup', endDrag);
		dragHandle.addEventListener('pointercancel', endDrag);

		window.addEventListener('resize', () => {
			if (!popupRoot.hidden) {
				const popupRect = popup.getBoundingClientRect();
				clampPosition(popupRect.left, popupRect.top);
			}
		});
	}
</script>
