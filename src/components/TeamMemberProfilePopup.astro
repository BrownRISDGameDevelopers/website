---
import { X } from '@lucide/astro';
---

<template data-team-popup-template>
	<div class="pointer-events-none fixed inset-0" data-team-popup-root>
		<section
			class="pointer-events-auto fixed left-4 top-4 flex w-[352px] max-w-[calc(100vw-2rem)] flex-col overflow-hidden border border-white/90 bg-[#181a2e]/25 text-white backdrop-blur-md max-[520px]:left-2 max-[520px]:top-2 max-[520px]:w-[min(calc(100vw-1rem),320px)] max-[520px]:max-w-[calc(100vw-1rem)]"
			role="dialog"
			aria-modal="false"
			aria-label="Profile"
			data-team-popup
		>
			<header
				class="flex cursor-grab select-none items-center justify-between border-b border-white/90 px-3 py-3 active:cursor-grabbing max-[520px]:px-2.5 max-[520px]:py-2.5"
				data-team-popup-drag-handle
			>
				<p class="m-0 text-xl leading-normal max-[520px]:text-lg">PROFILE</p>

				<div class="flex items-center gap-2">
					<span
						class="text-[11px] leading-none tracking-[0.08em] text-white/70 max-[520px]:hidden"
						aria-hidden="true"
					>
						[ESC]
					</span>
					<button
						type="button"
						class="flex size-5 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
						aria-label="Close profile"
						data-team-popup-close
					>
						<X class="size-5" aria-hidden="true" stroke-width={1.75} />
					</button>
				</div>
			</header>

			<div class="grid grid-cols-[112px_minmax(0,1fr)] border-b border-white/90 max-[520px]:grid-cols-[88px_minmax(0,1fr)]">
				<div
					class="flex min-h-28 items-center justify-center border-r border-white/90 bg-[#111325]/80 p-5 max-[520px]:min-h-24 max-[520px]:p-4"
				>
					<img
						class="block h-full w-full object-contain"
						src="/assets/brgd-logo-white.png"
						alt="BRGD logo"
						width="56"
						height="64"
						draggable="false"
						loading="eager"
					/>
				</div>

				<div class="flex flex-col justify-center gap-1 p-3 max-[520px]:p-2.5">
					<p
						class="m-0 text-[22px] leading-normal uppercase max-[520px]:text-[18px]"
						data-team-popup-name
					>
					</p>
					<p
						class="m-0 text-sm font-semibold leading-normal max-[520px]:text-xs"
						data-team-popup-school
					>
					</p>
				</div>
			</div>

			<div
				class="flex max-h-[calc(100vh-9rem)] flex-col gap-3 overflow-y-auto p-3 max-[720px]:max-h-[calc(100vh-10rem)] max-[520px]:max-h-[calc(100vh-7rem)] max-[520px]:gap-2.5 max-[520px]:p-2.5"
			>
				<p
					class="m-0 text-[18px] leading-normal whitespace-pre-line max-[520px]:text-base"
					data-team-popup-bio
				>
				</p>

				<div
					class="flex flex-col gap-0 text-sm leading-normal text-white/80"
					data-team-popup-games
				>
				</div>

				<div
					class="grid grid-cols-2 gap-3 max-[520px]:grid-cols-1"
					data-team-popup-links
					hidden
				>
				</div>
			</div>
		</section>
	</div>
</template>

<div data-team-popup-portal></div>

<script>
	type PopupGame = {
		role: string;
		title: string;
	};

	type PopupLink = {
		label: string;
		url: string;
	};

	type PopupMember = {
		bio: string;
		games: PopupGame[];
		grad: number;
		isEBoard: boolean;
		links: PopupLink[];
		name: string;
		school: 'RISD' | 'BROWN' | 'BROWN|RISD';
	};

	const popupTemplate = document.querySelector('[data-team-popup-template]');
	const popupPortal = document.querySelector('[data-team-popup-portal]');
	const triggerElements = document.querySelectorAll('[data-team-member-trigger]');

	if (
		popupTemplate instanceof HTMLTemplateElement &&
		popupPortal instanceof HTMLElement
	) {
		let highestZIndex = 100;
		let popupCount = 0;
		const openPopupRoots = new Map<string, HTMLElement>();
		const popupClosers = new WeakMap<HTMLElement, () => void>();

		const getSchoolMarkup = (
			school: PopupMember['school'],
			grad: number,
			isEBoard: boolean,
		) => {
			const gradLabel = `‘${String(grad).slice(-2)}`;
			const eBoardMarkup = isEBoard
				? '<span class="mx-2 inline-block size-[4px] translate-y-[-1px] bg-white align-middle"></span><span class="text-[#d8f5ff]/85">E-BOARD</span>'
				: '';

			if (school === 'BROWN|RISD') {
				return `<span class="text-[#d3c1bb]">BROWN</span><span class="text-white">|</span><span class="text-[#dfddff]">RISD</span><span class="text-white"> ${gradLabel}</span>${eBoardMarkup}`;
			}

			const schoolClass =
				school === 'RISD' ? 'text-[#dfddff]' : 'text-[#d3c1bb]';
			return `<span class="${schoolClass}">${school}</span><span class="text-white"> ${gradLabel}</span>${eBoardMarkup}`;
		};

		const bringToFront = (popupRoot: HTMLElement) => {
			highestZIndex += 1;
			popupRoot.style.zIndex = String(highestZIndex);
		};

		const clampPosition = (popup: HTMLElement, left: number, top: number) => {
			const viewportPadding = window.innerWidth <= 520 ? 8 : 16;
			const popupRect = popup.getBoundingClientRect();
			const maxLeft = Math.max(
				viewportPadding,
				window.innerWidth - popupRect.width - viewportPadding,
			);
			const maxTop = Math.max(
				viewportPadding,
				window.innerHeight - popupRect.height - viewportPadding,
			);

			popup.style.left = `${Math.min(
				Math.max(viewportPadding, left),
				maxLeft,
			)}px`;
			popup.style.top = `${Math.min(Math.max(viewportPadding, top), maxTop)}px`;
		};

		const renderLinks = (links: PopupLink[], linksElement: HTMLElement) => {
			linksElement.replaceChildren();

			if (links.length === 0) {
				linksElement.hidden = true;
				return;
			}

			const fragment = document.createDocumentFragment();

			for (const link of links.slice(0, 2)) {
				const anchor = document.createElement('a');
				anchor.href = link.url;
				anchor.target = '_blank';
				anchor.rel = 'noopener noreferrer';
				anchor.className =
					'pointer-events-auto relative z-0 inline-flex items-center justify-center border border-white bg-transparent px-6 py-3 text-sm leading-normal uppercase after:pointer-events-none after:absolute after:inset-0 after:-z-10 after:translate-x-[6px] after:translate-y-[6px] after:border after:border-white/33 after:bg-transparent after:[clip-path:polygon(100%_0,_100%_100%,_0_100%,_0_calc(100%_-_6px),_calc(100%_-_6px)_calc(100%_-_6px),_calc(100%_-_6px)_0)] max-[520px]:px-4 max-[520px]:py-2.5 max-[520px]:text-xs';
				anchor.textContent = link.label;
				fragment.append(anchor);
			}

			linksElement.hidden = false;
			linksElement.append(fragment);
		};

		const renderGames = (member: PopupMember, gamesElement: HTMLElement) => {
			gamesElement.replaceChildren();

			if (member.games.length === 0) {
				gamesElement.hidden = true;
				return;
			}

			for (const game of member.games) {
				const paragraph = document.createElement('p');
				paragraph.className = 'm-0';
				paragraph.textContent = game.role
					? `${game.role}, ${game.title}`
					: game.title;
				gamesElement.append(paragraph);
			}

			gamesElement.hidden = false;
		};

		const getPopupRoots = () =>
			Array.from(
				popupPortal.querySelectorAll<HTMLElement>('[data-team-popup-root]'),
			);

		const getTopmostPopupRoot = () => {
			let topmostRoot: HTMLElement | null = null;
			let topmostZIndex = -1;

			for (const popupRoot of getPopupRoots()) {
				const zIndex = Number.parseInt(popupRoot.style.zIndex || '0', 10);

				if (zIndex >= topmostZIndex) {
					topmostRoot = popupRoot;
					topmostZIndex = zIndex;
				}
			}

			return topmostRoot;
		};

		const openPopup = (
			member: PopupMember,
			memberKey: string,
			trigger?: HTMLElement,
		) => {
			const existingPopupRoot = openPopupRoots.get(memberKey);

			if (existingPopupRoot?.isConnected) {
				bringToFront(existingPopupRoot);
				return;
			}

			if (existingPopupRoot) {
				openPopupRoots.delete(memberKey);
			}

			const fragment = popupTemplate.content.cloneNode(true);

			if (!(fragment instanceof DocumentFragment)) {
				return;
			}

			const popupRoot = fragment.querySelector('[data-team-popup-root]');
			const popup = fragment.querySelector('[data-team-popup]');
			const dragHandle = fragment.querySelector('[data-team-popup-drag-handle]');
			const closeButton = fragment.querySelector('[data-team-popup-close]');
			const nameElement = fragment.querySelector('[data-team-popup-name]');
			const schoolElement = fragment.querySelector('[data-team-popup-school]');
			const bioElement = fragment.querySelector('[data-team-popup-bio]');
			const gamesElement = fragment.querySelector('[data-team-popup-games]');
			const linksElement = fragment.querySelector('[data-team-popup-links]');

			if (
				!(popupRoot instanceof HTMLElement) ||
				!(popup instanceof HTMLElement) ||
				!(dragHandle instanceof HTMLElement) ||
				!(closeButton instanceof HTMLButtonElement) ||
				!(nameElement instanceof HTMLElement) ||
				!(schoolElement instanceof HTMLElement) ||
				!(bioElement instanceof HTMLElement) ||
				!(gamesElement instanceof HTMLElement) ||
				!(linksElement instanceof HTMLElement)
			) {
				return;
			}

			popupCount += 1;
			const nameId = `team-profile-name-${popupCount}`;
			const cascadeOffset = ((popupCount - 1) % 6) * 18;
			let activePointerId: number | null = null;
			let dragOffsetX = 0;
			let dragOffsetY = 0;

			nameElement.id = nameId;
			nameElement.textContent = member.name.toLocaleUpperCase('en-US');
			schoolElement.innerHTML = getSchoolMarkup(
				member.school,
				member.grad,
				member.isEBoard,
			);
			bioElement.textContent = member.bio;
			popup.setAttribute('aria-labelledby', nameId);
			popup.removeAttribute('aria-label');
			renderGames(member, gamesElement);
			renderLinks(member.links, linksElement);
			bringToFront(popupRoot);

			const closePopup = () => {
				if (
					activePointerId !== null &&
					dragHandle.hasPointerCapture(activePointerId)
				) {
					dragHandle.releasePointerCapture(activePointerId);
				}

				activePointerId = null;
				openPopupRoots.delete(memberKey);
				popupRoot.remove();
			};

			openPopupRoots.set(memberKey, popupRoot);
			popupClosers.set(popupRoot, closePopup);

			popup.addEventListener('pointerdown', () => {
				bringToFront(popupRoot);
			});

			closeButton.addEventListener('click', closePopup);

			dragHandle.addEventListener('pointerdown', event => {
				if (
					event.button !== 0 ||
					(event.target instanceof Element &&
						event.target.closest(
							'[data-team-popup-close], a, button, input, textarea, select',
						))
				) {
					return;
				}

				bringToFront(popupRoot);
				const popupRect = popup.getBoundingClientRect();
				activePointerId = event.pointerId;
				dragOffsetX = event.clientX - popupRect.left;
				dragOffsetY = event.clientY - popupRect.top;
				dragHandle.setPointerCapture(event.pointerId);
			});

			dragHandle.addEventListener('pointermove', event => {
				if (event.pointerId !== activePointerId) {
					return;
				}

				clampPosition(
					popup,
					event.clientX - dragOffsetX,
					event.clientY - dragOffsetY,
				);
			});

			const endDrag = (event: PointerEvent) => {
				if (event.pointerId !== activePointerId) {
					return;
				}

				if (dragHandle.hasPointerCapture(event.pointerId)) {
					dragHandle.releasePointerCapture(event.pointerId);
				}

				activePointerId = null;
			};

			dragHandle.addEventListener('pointerup', endDrag);
			dragHandle.addEventListener('pointercancel', endDrag);

			popupPortal.append(fragment);

			window.requestAnimationFrame(() => {
				if (trigger instanceof HTMLElement) {
					const triggerRect = trigger.getBoundingClientRect();
					clampPosition(
						popup,
						triggerRect.left + cascadeOffset,
						triggerRect.top + 12 + cascadeOffset,
					);
					return;
				}

				const popupRect = popup.getBoundingClientRect();
				clampPosition(
					popup,
					(window.innerWidth - popupRect.width) / 2 + cascadeOffset,
					(window.innerHeight - popupRect.height) / 2 + cascadeOffset,
				);
			});
		};

		for (const trigger of triggerElements) {
			if (!(trigger instanceof HTMLButtonElement)) {
				continue;
			}

			trigger.addEventListener('click', () => {
				const payload = trigger.dataset.teamMember;

				if (!payload) {
					return;
				}

				openPopup(JSON.parse(payload) as PopupMember, payload, trigger);
			});
		}

		window.addEventListener('keydown', event => {
			if (event.key !== 'Escape') {
				return;
			}

			const topmostPopupRoot = getTopmostPopupRoot();

			if (!topmostPopupRoot) {
				return;
			}

			popupClosers.get(topmostPopupRoot)?.();
		});

		window.addEventListener('resize', () => {
			for (const popup of popupPortal.querySelectorAll<HTMLElement>(
				'[data-team-popup]',
			)) {
				const popupRect = popup.getBoundingClientRect();
				clampPosition(popup, popupRect.left, popupRect.top);
			}
		});
	}
</script>
